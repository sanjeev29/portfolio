---
import { GLOBAL } from "../../lib/variables";
---

<div class="flex flex-col items-center sm:flex-row gap-8">
    <img
        src={GLOBAL.profileImage}
        alt={GLOBAL.username}
        class="rounded-full max-w-60 w-60 h-60 z-0"
    />
    <div class="flex flex-col gap-4">
        <h1
            class="text-2xl sm:text-2xl font-display font-semibold text-center sm:text-left"
        >
            {GLOBAL.username}
        </h1>
        <h2
            class="mt-2 text-center text-lg sm:text-lg font-mono font-medium sm:text-left"
        >
            <p set:html={GLOBAL.shortDescription} />
        </h2>
        <h2
            class="text-center text-md sm:text-md font-mono font-medium sm:text-left"
        >
            <p set:html={GLOBAL.location} />
            <p set:html={GLOBAL.workStatus} />
        </h2>
    </div>
</div>
