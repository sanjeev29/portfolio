---
import { GLOBAL } from "../../lib/variables";
---

<div class="flex flex-col h-full justify-center items-center gap-10">
    <h3 class="font-display text-lg sm:text-xl leading-loose text-center">
        Skills
    </h3>

    <div class="space-y-6">
        {
            GLOBAL.skills.map((item) => (
                <div
                    class="p-4 rounded-lg border-2 border-zag-light-muted dark:border-zag-dark-muted \
                transition duration-300 ease-in-out hover:-translate-y-1 hover:scale-105 \
                hover:shadow-[0_0_10px_rgba(255,255,255,0.3)] focus:outline-none focus:ring-2 focus:ring-white \
                focus:ring-offset-2 focus:ring-offset-black"
                >
                    <h3 class="text-lg font-medium mb-3 text-center md:text-left flex items-center">
                        {item.title}
                    </h3>
                    <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                        {item.list.map((listItem) => (
                            <div
                                class="px-3 py-1 rounded-md text-sm border border-zag-light-muted \
                            dark:border-zag-dark-muted"
                            >
                                {listItem}
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</div>
